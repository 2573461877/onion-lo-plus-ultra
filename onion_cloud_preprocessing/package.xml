<?xml version="1.0"?>
<package format="2">
  <name>onion_cloud_preprocessing</name>
  <version>0.1.0</version>
  <description>
    Shared PointCloud2 vehicle-body crop and frame conversion for Onion
    mapping, localization, and replaceable global relocalizers.
  </description>

  <maintainer email="2573461877@qq.com">Onion-LO++ maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <exec_depend>tf</exec_depend>

  <export/>
</package>
