<?xml version="1.0"?>
<launch>
  <arg name="raw_lidar_topic" default="/fusion_rslidar_points"/>
  <arg name="filtered_sensor_topic"
       default="/onion/points_filtered_sensor"/>
  <arg name="filtered_vehicle_topic"
       default="/onion/points_filtered_vehicle"/>
  <arg name="vehicle_frame" default="vehicle_link"/>
  <arg name="publish_vehicle_static_tf" default="true"/>
  <arg name="min_x" default="-0.6"/>
  <arg name="max_x" default="1.65"/>
  <arg name="min_y" default="-0.7"/>
  <arg name="max_y" default="0.7"/>
  <arg name="min_z" default="-0.5"/>
  <arg name="max_z" default="2.5"/>
  <arg name="tf_timeout_sec" default="2.0"/>
  <arg name="fail_if_tf_unavailable" default="true"/>

  <group if="$(arg publish_vehicle_static_tf)">
    <include file="$(find onion_cloud_preprocessing)/launch/halo_vehicle_tf.launch"/>
  </group>

  <node pkg="onion_cloud_preprocessing"
        type="vehicle_crop_filter_node"
        name="onion_vehicle_crop_filter"
        output="screen"
        required="true">
    <param name="input_topic" value="$(arg raw_lidar_topic)"/>
    <param name="filtered_sensor_topic"
           value="$(arg filtered_sensor_topic)"/>
    <param name="filtered_vehicle_topic"
           value="$(arg filtered_vehicle_topic)"/>
    <param name="vehicle_frame" value="$(arg vehicle_frame)"/>
    <param name="min_x" value="$(arg min_x)"/>
    <param name="max_x" value="$(arg max_x)"/>
    <param name="min_y" value="$(arg min_y)"/>
    <param name="max_y" value="$(arg max_y)"/>
    <param name="min_z" value="$(arg min_z)"/>
    <param name="max_z" value="$(arg max_z)"/>
    <param name="tf_timeout_sec" value="$(arg tf_timeout_sec)"/>
    <param name="fail_if_tf_unavailable"
           value="$(arg fail_if_tf_unavailable)"/>
  </node>
</launch>
