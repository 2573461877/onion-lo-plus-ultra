<?xml version="1.0"?>
<launch>
  <arg name="bagfile" default=""/>
  <arg name="bag_start" default="0.0"/>
  <arg name="bag_delay" default="2.0"/>
  <!-- Correctness-first default for offline indoor mapping. Increase only
       after processing remains below the effective input period. -->
  <arg name="bag_rate" default="0.05"/>
  <arg name="config_file"
       default="$(find onion_lo_plus)/config/livox.yaml"/>
  <arg name="lidar_topic" default="/livox/lidar"/>
  <arg name="visualize" default="true"/>
  <arg name="localization_mode" default="false"/>
  <arg name="wait_for_initial_pose" default="false"/>
  <arg name="initial_pose_cloud_buffer_size" default="50"/>
  <arg name="initial_pose_replay_tolerance_sec" default="0.05"/>
  <arg name="traj_voxel_size" default="1.0"/>
  <arg name="map_path" default="results/onion_map.pcd"/>
  <arg name="loaded_map_max_points_per_voxel" default="150"/>
  <arg name="publish_global_map" default="true"/>
  <arg name="save_map_on_shutdown" default="true"/>
  <arg name="initial_x" default="0.0"/>
  <arg name="initial_y" default="0.0"/>
  <arg name="initial_z" default="0.0"/>
  <arg name="initial_roll" default="0.0"/>
  <arg name="initial_pitch" default="0.0"/>
  <arg name="initial_yaw" default="0.0"/>
  <arg name="metrics_output_path" default=""/>
  <arg name="diagnostic_output_directory" default="results/diagnostics"/>
  <arg name="vehicle_crop_enabled" default="false"/>
  <arg name="vehicle_crop_frame" default="vehicle_link"/>
  <arg name="vehicle_crop_min_x" default="-1.0"/>
  <arg name="vehicle_crop_max_x" default="1.0"/>
  <arg name="vehicle_crop_min_y" default="-1.0"/>
  <arg name="vehicle_crop_max_y" default="1.0"/>
  <arg name="vehicle_crop_min_z" default="-1.0"/>
  <arg name="vehicle_crop_max_z" default="2.0"/>
  <arg name="vehicle_crop_tf_timeout_sec" default="1.0"/>
  <arg name="vehicle_crop_fail_if_tf_unavailable" default="true"/>
  <!-- Odometry node -->
  <node pkg="onion_lo_plus" type="onion_lo_plus_node"
        name="onion_lo_plus_node" output="screen" required="true">
    <rosparam command="load" file="$(arg config_file)" />
     <param name="Onion/lidar_topic" value="$(arg lidar_topic)"/>
     <param name="Map/localization_mode" value="$(arg localization_mode)"/>
     <param name="Map/wait_for_initial_pose"
            value="$(arg wait_for_initial_pose)"/>
     <param name="Map/initial_pose_cloud_buffer_size"
            value="$(arg initial_pose_cloud_buffer_size)"/>
     <param name="Map/initial_pose_replay_tolerance_sec"
            value="$(arg initial_pose_replay_tolerance_sec)"/>
     <param name="Traj/voxel_size" value="$(arg traj_voxel_size)"/>
     <param name="Map/map_path" value="$(arg map_path)"/>
     <param name="Map/loaded_map_max_points_per_voxel"
            value="$(arg loaded_map_max_points_per_voxel)"/>
     <param name="Map/publish_global_map" value="$(arg publish_global_map)"/>
     <param name="Map/save_map_on_shutdown" value="$(arg save_map_on_shutdown)"/>
     <rosparam param="Map/initial_pose" subst_value="true">[$(arg initial_x), $(arg initial_y), $(arg initial_z), $(arg initial_roll), $(arg initial_pitch), $(arg initial_yaw)]</rosparam>
     <param name="Diagnostics/metrics_output_path"
            value="$(arg metrics_output_path)"/>
     <param name="Diagnostics/output_directory"
            value="$(arg diagnostic_output_directory)"/>
     <param name="VehicleCrop/enabled"
            value="$(arg vehicle_crop_enabled)"/>
     <param name="VehicleCrop/frame_id"
            value="$(arg vehicle_crop_frame)"/>
     <param name="VehicleCrop/min_x" value="$(arg vehicle_crop_min_x)"/>
     <param name="VehicleCrop/max_x" value="$(arg vehicle_crop_max_x)"/>
     <param name="VehicleCrop/min_y" value="$(arg vehicle_crop_min_y)"/>
     <param name="VehicleCrop/max_y" value="$(arg vehicle_crop_max_y)"/>
     <param name="VehicleCrop/min_z" value="$(arg vehicle_crop_min_z)"/>
     <param name="VehicleCrop/max_z" value="$(arg vehicle_crop_max_z)"/>
     <param name="VehicleCrop/tf_timeout_sec"
            value="$(arg vehicle_crop_tf_timeout_sec)"/>
     <param name="VehicleCrop/fail_if_tf_unavailable"
            value="$(arg vehicle_crop_fail_if_tf_unavailable)"/>
  </node>
  <!-- Rosbag player, if bagfile argument was specified -->
  <group if="$(eval bagfile != '')">
    <param name="/use_sim_time" value="true"/>
    <node pkg="rosbag" type="play" name="player"
          args="--clock --delay=$(arg bag_delay) --start=$(arg bag_start) --rate=$(arg bag_rate) $(arg bagfile)"
          output="screen" required="true"/>
  </group>

  <!-- Visualizer -->
  <group if="$(arg visualize)">
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find onion_lo_plus)/rviz/onion_lo_plus_ros1.rviz"/>
  </group>

</launch>
