<?xml version="1.0"?>
<launch>
  <arg name="map_path"
       default="$(find onion_lo_plus)/results/onion_map.pcd"/>
  <arg name="global_map_path" default="$(arg map_path)"/>
  <arg name="refinement_map_path" default="$(arg map_path)"/>
  <arg name="map_frame" default="odom"/>
  <arg name="lidar_topic" default="/livox/lidar"/>
  <arg name="config_file"
       default="$(find onion_lo_plus)/config/livox.yaml"/>
  <arg name="global_localization_engine" default="FPFH_RANSAC"/>
  <arg name="auto_relocalize" default="true"/>
  <arg name="max_num_candidates" default="3"/>
  <arg name="max_query_attempts" default="3"/>
  <arg name="min_inlier_fraction" default="0.25"/>
  <arg name="max_matching_error" default="-1.0"/>
  <arg name="enable_candidate_refinement" default="true"/>
  <arg name="refinement_target_leaf_size" default="0.20"/>
  <arg name="refinement_query_leaf_size" default="0.20"/>
  <arg name="refinement_submap_xy_radius" default="80.0"/>
  <arg name="refinement_submap_z_radius" default="8.0"/>
  <arg name="ndt_resolution" default="1.0"/>
  <arg name="ndt_step_size" default="0.20"/>
  <arg name="ndt_transformation_epsilon" default="0.01"/>
  <arg name="ndt_max_iterations" default="40"/>
  <arg name="icp_max_correspondence_distance" default="0.60"/>
  <arg name="icp_transformation_epsilon" default="0.00001"/>
  <arg name="icp_euclidean_fitness_epsilon" default="0.00001"/>
  <arg name="icp_max_iterations" default="50"/>
  <arg name="validation_max_correspondence_distance" default="0.30"/>
  <arg name="validation_min_inlier_fraction" default="0.45"/>
  <arg name="validation_max_rmse" default="0.18"/>
  <arg name="validation_azimuth_sectors" default="12"/>
  <arg name="validation_min_azimuth_sectors" default="6"/>
  <arg name="validation_min_sector_inliers" default="5"/>
  <arg name="max_refinement_translation" default="10.0"/>
  <arg name="max_refinement_rotation_deg" default="25.0"/>

  <!-- The saved Onion map is a dense 0.1 m centroid map. The upstream
       defaults target much sparser HDL maps and are prohibitively expensive
       on this ARM64 device, so use a coarser feature cloud by default. -->
  <arg name="globalmap_downsample_resolution" default="1.0"/>
  <arg name="query_downsample_resolution" default="1.0"/>
  <arg name="fpfh_normal_estimation_radius" default="1.5"/>
  <arg name="fpfh_search_radius" default="3.0"/>
  <arg name="ransac_max_iterations" default="200000"/>
  <arg name="ransac_matching_budget" default="3000"/>

  <arg name="bagfile" default=""/>
  <arg name="bag_start" default="0.0"/>
  <arg name="bag_delay" default="5.0"/>
  <arg name="bag_rate" default="0.05"/>
  <arg name="visualize" default="true"/>
  <arg name="loaded_map_max_points_per_voxel" default="150"/>
  <arg name="metrics_output_path" default=""/>
  <arg name="diagnostic_output_directory"
       default="$(find onion_lo_plus)/results/diagnostics"/>

  <!-- Keep the upstream package independent. This launch file only loads its
       public configuration and connects to its ROS services. -->
  <rosparam command="load"
            file="$(find hdl_global_localization)/config/general_config.yaml"
            ns="/hdl_global_localization"/>
  <rosparam command="load"
            file="$(find hdl_global_localization)/config/bbs_config.yaml"
            ns="/hdl_global_localization"/>
  <rosparam command="load"
            file="$(find hdl_global_localization)/config/fpfh_config.yaml"
            ns="/hdl_global_localization"/>
  <rosparam command="load"
            file="$(find hdl_global_localization)/config/ransac_config.yaml"
            ns="/hdl_global_localization"/>

  <param name="/hdl_global_localization/global_localization_engine"
         value="$(arg global_localization_engine)"/>
  <param name="/hdl_global_localization/globalmap_downsample_resolution"
         value="$(arg globalmap_downsample_resolution)"/>
  <param name="/hdl_global_localization/query_downsample_resolution"
         value="$(arg query_downsample_resolution)"/>
  <param name="/hdl_global_localization/fpfh/normal_estimation_radius"
         value="$(arg fpfh_normal_estimation_radius)"/>
  <param name="/hdl_global_localization/fpfh/search_radius"
         value="$(arg fpfh_search_radius)"/>
  <param name="/hdl_global_localization/ransac/max_iterations"
         value="$(arg ransac_max_iterations)"/>
  <param name="/hdl_global_localization/ransac/matching_budget"
         value="$(arg ransac_matching_budget)"/>

  <node pkg="hdl_global_localization"
        type="hdl_global_localization_node"
        name="hdl_global_localization"
        output="screen"
        required="true"/>

  <node pkg="onion_global_relocalization"
        type="onion_global_relocalization_node"
        name="onion_global_relocalization"
        output="screen"
        required="true">
    <param name="map_path" value="$(arg global_map_path)"/>
    <param name="refinement_map_path" value="$(arg refinement_map_path)"/>
    <param name="map_frame" value="$(arg map_frame)"/>
    <param name="lidar_topic" value="$(arg lidar_topic)"/>
    <param name="auto_relocalize" value="$(arg auto_relocalize)"/>
    <param name="max_num_candidates" value="$(arg max_num_candidates)"/>
    <param name="max_query_attempts" value="$(arg max_query_attempts)"/>
    <param name="min_inlier_fraction" value="$(arg min_inlier_fraction)"/>
    <param name="max_matching_error" value="$(arg max_matching_error)"/>
    <param name="enable_candidate_refinement"
           value="$(arg enable_candidate_refinement)"/>
    <param name="refinement_target_leaf_size"
           value="$(arg refinement_target_leaf_size)"/>
    <param name="refinement_query_leaf_size"
           value="$(arg refinement_query_leaf_size)"/>
    <param name="refinement_submap_xy_radius"
           value="$(arg refinement_submap_xy_radius)"/>
    <param name="refinement_submap_z_radius"
           value="$(arg refinement_submap_z_radius)"/>
    <param name="ndt_resolution" value="$(arg ndt_resolution)"/>
    <param name="ndt_step_size" value="$(arg ndt_step_size)"/>
    <param name="ndt_transformation_epsilon"
           value="$(arg ndt_transformation_epsilon)"/>
    <param name="ndt_max_iterations" value="$(arg ndt_max_iterations)"/>
    <param name="icp_max_correspondence_distance"
           value="$(arg icp_max_correspondence_distance)"/>
    <param name="icp_transformation_epsilon"
           value="$(arg icp_transformation_epsilon)"/>
    <param name="icp_euclidean_fitness_epsilon"
           value="$(arg icp_euclidean_fitness_epsilon)"/>
    <param name="icp_max_iterations" value="$(arg icp_max_iterations)"/>
    <param name="validation_max_correspondence_distance"
           value="$(arg validation_max_correspondence_distance)"/>
    <param name="validation_min_inlier_fraction"
           value="$(arg validation_min_inlier_fraction)"/>
    <param name="validation_max_rmse"
           value="$(arg validation_max_rmse)"/>
    <param name="validation_azimuth_sectors"
           value="$(arg validation_azimuth_sectors)"/>
    <param name="validation_min_azimuth_sectors"
           value="$(arg validation_min_azimuth_sectors)"/>
    <param name="validation_min_sector_inliers"
           value="$(arg validation_min_sector_inliers)"/>
    <param name="max_refinement_translation"
           value="$(arg max_refinement_translation)"/>
    <param name="max_refinement_rotation_deg"
           value="$(arg max_refinement_rotation_deg)"/>
  </node>

  <include file="$(find onion_lo_plus)/launch/livox.launch">
    <arg name="config_file" value="$(arg config_file)"/>
    <arg name="bagfile" value="$(arg bagfile)"/>
    <arg name="bag_start" value="$(arg bag_start)"/>
    <arg name="bag_delay" value="$(arg bag_delay)"/>
    <arg name="bag_rate" value="$(arg bag_rate)"/>
    <arg name="visualize" value="$(arg visualize)"/>
    <arg name="localization_mode" value="true"/>
    <arg name="wait_for_initial_pose" value="true"/>
    <arg name="map_path" value="$(arg map_path)"/>
    <arg name="loaded_map_max_points_per_voxel"
         value="$(arg loaded_map_max_points_per_voxel)"/>
    <arg name="publish_global_map" value="false"/>
    <arg name="save_map_on_shutdown" value="false"/>
    <arg name="metrics_output_path" value="$(arg metrics_output_path)"/>
    <arg name="diagnostic_output_directory"
         value="$(arg diagnostic_output_directory)"/>
  </include>
</launch>
